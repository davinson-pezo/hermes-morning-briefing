.installed.cfg
*.egg

# Configuración con API keys
config.yaml
.env
*.env

# Datos temporales
data/raw/*.json
data/translated/*.json
data/logs/*.log
data/logs/*.txt
data/logs/debug_*

# Outputs (opcional - si querés mantener histórico en git, comentar estas líneas)
output/markdown/*.md
output/audio/*.ogg
output/audio/*.txt
output/audio/*.aiff

# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation builds
docs/_build/
